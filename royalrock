const shippingRates = {
    northwest: 1500,
    littoral: 2500,
    centre: 2500,
    west: 2000,
    other: 5000
};

function calculateShipping() {
    const region = document.getElementById('region')?.value;
    const shippingInput = document.getElementById('shippingEstimate');
    
