    font-weight: bold;
}

.step-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

/* 3D Products Grid */
.products-3d-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 40px;
    perspective: 1000px;
}

.product-3d-card {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.5s ease;
    transform-style: preserve-3d;
    cursor: pointer;
}

.product-3d-card:hover {
    transform: translateY(-15px) rotateX(5deg);
    box-shadow: 0 30px 40px rgba(0,0,0,0.3);
}

.product-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
}

.product-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--secondary);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
}

.product-info {
    padding: 20px;
}

.product-title {
    font-size: 1.2rem;
    margin-bottom: 10px;
}

.product-price {
    font-size: 1.3rem;
    color: var(--secondary);
    font-weight: bold;
    margin: 10px 0;
}

.product-ingredients {
    font-size: 0.8rem;
    color: #ccc;
    margin: 10px 0;
    padding: 10px;
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
}

.product-diseases {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 10px 0;
}

.disease-tag {
    background: rgba(218, 165, 32, 0.2);
    padding: 3px 10px;
    border-radius: 15px;
    font-size: 0.7rem;
}

.affiliate-badge {
    position: absolute;
    bottom: 15px;
    right: 15px;
    background: var(--success);
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
}

/* Restaurant Preview */
.restaurant-preview {
    padding: 120px 0;
    background: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1920') center/cover fixed;
    position: relative;
}

.preview-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
}

.preview-content h2 {
    font-size: 3rem;
    margin-bottom: 20px;
}

.preview-content h2 span {
    color: var(--secondary);
}

/* Menu Tabs */
.menu-tabs {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.menu-tab {
    padding: 10px 25px;
    background: transparent;
    border: 2px solid var(--secondary);
    color: var(--secondary);
    border-radius: 50px;
    cursor: pointer;
    transition: 0.3s;
}

.menu-tab.active, .menu-tab:hover {
    background: var(--secondary);
    color: var(--dark);
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
}

.menu-card {
    background: rgba(255,255,255,0.05);
    border-radius: 15px;
    overflow: hidden;
    transition: 0.3s;
}

.menu-card:hover {
    transform: translateY(-5px);
}

.menu-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.menu-card-info {
    padding: 20px;
}

.menu-price {
    color: var(--secondary);
    font-size: 1.2rem;
    font-weight: bold;
}

/* Cart Section */
.cart-section, .checkout-section {
    padding: 80px 0;
}

.cart-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
}

.cart-items {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 20px;
}

.cart-item {
    display: grid;
    grid-template-columns: 80px 2fr 1fr auto;
    gap: 15px;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.cart-item-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 10px;
}

.cart-item-quantity {
    display: flex;
    align-items: center;
    gap: 10px;
}

.quantity-btn {
    width: 30px;
    height: 30px;
    background: rgba(255,255,255,0.1);
    border: none;
    border-radius: 5px;
    color: white;
    cursor: pointer;
}

.remove-item {
    color: var(--danger);
    cursor: pointer;
}

.cart-summary {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 25px;
    height: fit-content;
    position: sticky;
    top: 100px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
}

.summary-row.total {
    border-top: 1px solid rgba(255,255,255,0.1);
    margin-top: 10px;
    padding-top: 15px;
    font-weight: bold;
    font-size: 1.2rem;
}

.checkout-btn {
    width: 100%;
    margin-top: 20px;
}

.empty-cart {
    text-align: center;
    padding: 50px;
}

/* Checkout Grid */
.checkout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
}

.checkout-form {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 30px;
}

.checkout-form input, .checkout-form select, .checkout-form textarea {
    width: 100%;
    padding: 12px;
    margin: 10px 0;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 10px;
    color: white;
    font-family: inherit;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.payment-methods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin: 15px 0;
}

.payment-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
    cursor: pointer;
}

.order-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.info-card {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 25px;
}

.info-card ul {
    list-style: none;
    margin-top: 15px;
}

.info-card li {
    margin: 10px 0;
}

.info-card li i {
    color: var(--success);
    margin-right: 10px;
}

/* Dashboard */
.dashboard-header {
    padding: 120px 0 40px;
    text-align: center;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
    margin-bottom: 50px;
}

.stat-card {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 25px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: 0.3s;
}

.stat-card:hover {
    transform: translateY(-5px);
}

.stat-icon {
    font-size: 2.5rem;
}

.stat-value {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--secondary);
}

.referral-card {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 30px;
    text-align: center;
    margin-bottom: 50px;
}

.referral-link-box {
    display: flex;
    margin: 20px 0;
}

.referral-link-box input {
    flex: 1;
    padding: 12px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 10px 0 0 10px;
    color: white;
}

.referral-link-box button {
    padding: 12px 20px;
    background: var(--secondary);
    border: none;
    border-radius: 0 10px 10px 0;
    cursor: pointer;
}

.share-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.share-wa, .share-fb, .share-tw {
    padding: 10px 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
}

.share-wa { background: #25D366; color: white; }
.share-fb { background: #1877F2; color: white; }
.share-tw { background: #1DA1F2; color: white; }

.transactions-table {
    overflow-x: auto;
}

.transactions-table table {
    width: 100%;
    border-collapse: collapse;
}

.transactions-table th, .transactions-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.transactions-table th {
    color: var(--secondary);
}

/* Affiliate Banner */
.affiliate-banner {
    padding: 60px 0;
    background: linear-gradient(135deg, var(--primary-dark), var(--dark));
}

.banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
}

.banner-stats {
    display: flex;
    gap: 40px;
}

.banner-stat {
    text-align: center;
}

.banner-stat h3 {
    font-size: 2rem;
    color: var(--secondary);
}

/* Testimonials */
.testimonials {
    padding: 80px 0;
}

.testimonials-slider {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.testimonial-card {
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 30px;
    text-align: center;
}

.testimonial-card i {
    font-size: 2rem;
    color: var(--secondary);
    margin-bottom: 15px;
}

/* CTA Section */
.cta {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--secondary), var(--primary));
    text-align: center;
}

.cta h2 {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

.cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 30px;
}

.cta .btn-primary {
    background: white;
    color: var(--primary);
}

.cta .btn-outline {
    border-color: white;
    color: white;
}

/* Footer */
footer {
    background: #0f0f1a;
    padding: 60px 0 20px;
}

.footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
}

.footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
}

.footer-logo span {
    font-size: 2rem;
}

.footer-social {
    display: flex;
    gap: 15px;
    margin-top: 20px;
}

.footer-social a {
    width: 35px;
    height: 35px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: 0.3s;
}

.footer-social a:hover {
    background: var(--secondary);
    transform: translateY(-3px);
}

.footer-links h4, .footer-contact h4 {
    margin-bottom: 20px;
}

.footer-links a {
    display: block;
    color: #aaa;
    text-decoration: none;
    margin-bottom: 10px;
    transition: 0.3s;
}

.footer-links a:hover {
    color: var(--secondary);
    transform: translateX(5px);
}

.footer-contact p {
    margin-bottom: 10px;
    color: #aaa;
}

.footer-contact i {
    width: 25px;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.1);
    color: #aaa;
    font-size: 0.8rem;
}

/* WhatsApp Float */
.whatsapp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #25D366;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    text-decoration: none;
    z-index: 999;
    transition: 0.3s;
    box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
}

.whatsapp-float:hover {
    transform: scale(1.1);
}

/* Responsive */
@media (max-width: 768px) {
    .nav-links {
        display: none;
    }
    .mobile-menu {
        display: block;
    }
    .hero h1 {
        font-size: 2rem;
    }
    .hero-buttons, .cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    .cart-container, .checkout-grid, .banner-content {
        grid-template-columns: 1fr;
        flex-direction: column;
    }
    .form-row {
        grid-template-columns: 1fr;
    }
    .payment-methods {
        grid-template-columns: 1fr;
    }
    .hero-stats {
        gap: 20px;
        flex-wrap: wrap;
    }
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.feature-card, .step, .product-3d-card, .menu-card {
    animation: fadeInUp 0.6s ease forwards;
}

/* Page Header */
.page-header {
    padding: 120px 0 60px;
    text-align: center;
    background: linear-gradient(135deg, var(--dark), #0a0a15);
}

.page-header h1 {
    font-size: 2.5rem;
}

.page-header h1 span {
    color: var(--secondary);
}

/* Filters */
.filters {
    padding: 30px 0;
    background: rgba(0,0,0,0.3);
}

.filter-row {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.filter-group {
    flex: 1;
    min-width: 200px;
}

.filter-input, .filter-select {
    width: 100%;
    padding: 12px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 10px;
    color: white;
}

/* No Results */
.no-results {
    text-align: center;
    padding: 50px;
}

.no-results i {
    font-size: 3rem;
    color: #aaa;
    margin-bottom: 15px;
}
